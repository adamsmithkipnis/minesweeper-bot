# Copy to .env and fill in. NEVER commit .env — it holds the app password.
# Use a Bluesky *app password* (Settings > Privacy and Security > App
# Passwords), never the account's real password.
BLUESKY_HANDLE=playminesweeper.bsky.social
BLUESKY_APP_PASSWORD=xxxx-xxxx-xxxx-xxxx

# Board. 9x9 with 13 mines runs a median of 24 turns — about a day at one
# turn an hour. Drop MINES to 11 for a gentler board if runs keep ending
# early (median 19 turns, and a noticeably higher clear rate).
ROWS=9
COLS=9
MINES=13
# Difficulty tiers: size and mine density rise together. A well-played win
# promotes the next board; a board the bot had to carry demotes it. ROWS/COLS/
# MINES above are used only when ADAPTIVE_BOARD=0.
ADAPTIVE_BOARD=1
TIERS=9x9:13, 10x10:18, 11x11:24
GROW_PARTICIPATION=0.75
SHRINK_PARTICIPATION=0.50

# Knockout play: everyone who replies opens their own cell, and a mine takes
# that player out of the board instead of ending it. The board itself fails
# once more than (tier + MINE_BUDGET_BASE) mines have gone off.
KNOCKOUT=0
MINE_BUDGET_BASE=1

TURN_MINUTES=30
RESTART_DELAY_SECONDS=3600

# How many followers must agree before the crowd's pick is played. Below this
# the bot plays its own safest cell and says so in the post. Worth 18 points
# of clear rate against vote splitting; see tests/simulate.py.
QUORUM=2

DB_PATH=/Users/robot/minesweeper-bot/minesweeper.db
LOG_PATH=/Users/robot/minesweeper-bot/minesweeper.log

# 'live' posts to Bluesky. 'dry' writes posts to DRY_DIR and never uses the
# network — no credentials needed.
POST_MODE=live
DRY_DIR=dry-run

# Hashtags. HASHTAG_ALWAYS is on every post; HASHTAG_COUNT more are sampled
# fresh per post from HASHTAG_POOL, so the account does not post the same
# block of tags 24 times a day. All are appended only while they still fit
# under 300 characters.
HASHTAG_ALWAYS=#Minesweeper
HASHTAG_COUNT=5
HASHTAG_POOL=#gamedev #indiedev #solodev #indiegames #indiegame #gamedevelopment #puzzle #puzzlegames #logicpuzzles #braingames #retrogaming #retrogames #classicgames #play #playtogether #crowdplay #dailygame #gamenight #bots #botsky #bskygames #opensource #python

# Replies to individual followers get this one tag only — six in a personal
# reply reads as spam.
REPLY_HASHTAG=#Minesweeper
DASHBOARD_PORT=8766
